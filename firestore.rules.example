rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /equipos/{equipoId} {
      // DEMO solamente: permite lectura/escritura a cualquier visitante.
      // No publiques estas reglas en producción.
      allow read, write: if true;
    }
    match /herramientas/{herramientaId} {
      // DEMO solamente: permite lectura/escritura a cualquier visitante.
      // No publiques estas reglas en producción.
      allow read, write: if true;
    }
    match /internet/{redId} {
      // DEMO solamente: contiene contraseñas de redes en texto normal.
      // No publiques estas reglas en producción.
      allow read, write: if true;
    }
    match /areas/{areaId} {
      // DEMO solamente: contiene contraseñas de cuentas en texto normal.
      // No publiques estas reglas en producción.
      allow read, write: if true;
    }
  }
}
